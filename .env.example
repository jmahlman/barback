# ---------------------------------------------------------------------------
# Barback configuration
# Copy to .env and adjust. Everything here has a sane default for local use.
# ---------------------------------------------------------------------------

# Where the SQLite database lives. Keep this on a mounted volume in Docker.
DATABASE_URL="file:./data/barback.db"

# Directory for uploaded recipe photos. Also keep on a mounted volume.
UPLOAD_DIR="./data/uploads"

# --- Authentication --------------------------------------------------------
# How people get in. One of:
#   local  Barback's own email and password sign-in. The default.
#   proxy  A reverse proxy in front (Authelia, Authentik, Traefik
#          forward-auth, oauth2-proxy, Caddy) has already authenticated the
#          request and passes the identity in headers.
#   none   No authentication at all. Everyone is the same single user.
#          Only for a network you trust.
#
# Leave this unset to manage the mode from the Settings page instead.
# Setting it here pins the mode and makes that dropdown read-only — which is
# also the way back in if a mode change ever locks you out.
# AUTH_MODE="local"

# REQUIRED in local mode; harmless otherwise. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-plus-character-string"

# Public URL of your Barback instance (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# local mode: whether people can create their own account.
# This is only the starting value — it is a toggle on the Settings page.
ALLOW_SIGNUPS="true"

# --- proxy mode ------------------------------------------------------------
# Header names. The defaults match Authelia and Authentik.
# AUTH_PROXY_USER_HEADER="Remote-User"
# AUTH_PROXY_EMAIL_HEADER="Remote-Email"
# AUTH_PROXY_NAME_HEADER="Remote-Name"
# AUTH_PROXY_GROUPS_HEADER="Remote-Groups"

# STRONGLY RECOMMENDED. A value your proxy must send with every request.
# Without it, anything that can reach Barback directly can claim to be any
# user simply by setting Remote-User. With it, bypassing the proxy is not
# enough. Generate with: openssl rand -base64 32
# AUTH_PROXY_SHARED_SECRET=
# AUTH_PROXY_SECRET_HEADER="X-Barback-Proxy-Secret"

# Members of this group become Barback admins. Leave unset to manage roles
# in Barback instead of in your directory.
# AUTH_PROXY_ADMIN_GROUP="barback-admins"

# Barback matches people by username first, because that is what Authelia
# and Authentik send. When a proxy supplies a username but no email, this
# domain is used to build a placeholder address, which is replaced
# automatically if a real one ever arrives.
# AUTH_PROXY_EMAIL_DOMAIN="proxy.local"

# --- none mode -------------------------------------------------------------
# The single account everything belongs to.
# SINGLE_USER_EMAIL="you@barback.local"
# SINGLE_USER_NAME="You"

# --- Cocktail data ----------------------------------------------------------
# These are starting values only. Everything here can also be set on the
# Settings page inside the app, and a value saved there wins over the
# environment, so you can change a key without redeploying.
#
# Lookups never run on their own — only when you press a button.

# Which provider to ask: "cocktaildb" (default) or "apininjas".
# TheCocktailDB is recommended: it has photos, glassware and stable links,
# and it separates measures from ingredient names. API Ninjas is text-only,
# caps results at 10 per search, and matches ingredients loosely.
COCKTAIL_PROVIDER="cocktaildb"

# Try the other provider when the first one fails. Off by default, because
# the two return noticeably different data.
COCKTAIL_PROVIDER_FALLBACK="false"

# TheCocktailDB. "1" is the free development key. Get a production key before
# you expose your instance publicly: https://www.thecocktaildb.com/api.php
COCKTAILDB_API_KEY="1"

# API Ninjas. Free key from https://api-ninjas.com/api/cocktail
# API_NINJAS_API_KEY=

# --- Barcode scanning ------------------------------------------------------

# Reading a barcode happens in your browser and needs nothing here. This only
# governs looking up what the barcode IS, which asks UPCitemdb. Turning it off
# leaves the scanner working: it fills the barcode in and you type the name.
BARCODE_LOOKUP="true"

# UPCitemdb. The free tier needs no key: 100 lookups a day, counted per IP
# address, so shared with everything else on your connection. A key raises
# that well past anything a home bar will reach: https://devs.upcitemdb.com/
# UPCITEMDB_API_KEY=
